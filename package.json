{
  "name": "dsh-context-dial",
  "version": "0.2.0",
  "description": "Set a model's context window from a plugin page in DSH settings; applied on the next DSH start.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "plan.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "context-window",
    "compaction"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/studentlanily/dsh-context-dial.git"
  },
  "bugs": {
    "url": "https://github.com/studentlanily/dsh-context-dial/issues"
  },
  "homepage": "https://github.com/studentlanily/dsh-context-dial#readme",
  "author": "studentlanily",
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.0"
  }
}
